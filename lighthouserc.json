{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3000",
      "startServerReadyPattern": "Ready",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/work",
        "http://localhost:3000/work/onboarding-funnel-redesign",
        "http://localhost:3000/work/adaptive-assignment-engine",
        "http://localhost:3000/decisions",
        "http://localhost:3000/about",
        "http://localhost:3000/ai-lab",
        "http://localhost:3000/ai-lab/learner-diagnostic"
      ],
      "settings": { "formFactor": "mobile", "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
